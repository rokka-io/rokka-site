---
/**
 * Port of source/documentation/index.html (layout: default).
 *
 * English-only and hard-coded English headings, as before -- this page was
 * never part of the bilingual tree.
 */
import Base from '../../layouts/Base.astro';
import ArticleList from '../../components/ArticleList.astro';
import { getSite, titleCase, canonicalUrl } from '../../data/site';
import { docLinks } from '../../data/docs';

const site = getSite('en');
const [guides, references, demos] = await Promise.all([
  docLinks('guides'),
  docLinks('references'),
  docLinks('demos'),
]);

const title = 'Documentation';
const description =
  'Feel free to read the Guide to get a general overview of rokka or have a look at the API reference.';
---

<Base
  lang="en"
  title={`${titleCase(title)} | ${site.title}`}
  canonical={canonicalUrl('/documentation')}
  pageUrl="/documentation"
  pageTitle={title}
  pageDescription={description}
>
<div class="grid">
    <div class="grid__item md-w-1/3">
        <h2 class="h3">Guide</h2>
        <ArticleList articles={guides} currentUrl="/documentation" />
        <h2 class="h3">Demos</h2>
        <ArticleList articles={demos} currentUrl="/documentation" />

    </div>
    <div class="grid__item md-w-1/3">
        <h2 class="h3">API Reference</h2>
        <ArticleList articles={references} currentUrl="/documentation" />
    </div>
    <div class="grid__item md-w-1/3">
        <h2 class="h3">More</h2>

        <ul class="list-stacked list-stacked--divided">
            {site.rokka_more_links.map((library) => (
            <li class="list-group-item"><a href={library.link}>{library.title}</a></li>
            ))}
        </ul>
        <h2 class="h3">API Client Libraries</h2>
        <ul class="list-stacked list-stacked--divided">
            {site.rokka_libraries.map((library) => (
                <li class="list-group-item"><a href={library.link}>{library.title}</a></li>
            ))}
        </ul>

        <h2 class="h3">Framework and CMS Plugins</h2>
        <ul class="list-stacked list-stacked--divided">
            {site.rokka_framework_plugins.map((library) => (
            <li class="list-group-item"><a href={library.link}>{library.title}</a></li>
            ))}
        </ul>

    </div>
</div>
</Base>
