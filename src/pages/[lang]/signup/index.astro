---
/**
 * Port of source/signup/index.html (layout: default, multilang).
 *
 * The Pipedrive web form differs per language -- two different form ids, picked
 * by `{% if site.language == 'en' %}` in the original. Its loader script is
 * `is:inline` so it stays a classic third-party script.
 */
import Base from '../../../layouts/Base.astro';
import Check from '../../../assets/images/icons/check.svg';
import { getSite, languagePaths, canonicalUrl, type Language } from '../../../data/site';

export function getStaticPaths() {
  return languagePaths();
}

const lang = Astro.params.lang as Language;
const site = getSite(lang);
const s = site.text.signup;

const PIPEDRIVE_FORM = {
  en: 'https://pipedrivewebforms.com/form/5b7fe87c9d421d3eb7a599b96f641cb4311935',
  de: 'https://pipedrivewebforms.com/form/fb71503123334536ddbe5e96e8cdbad2311935',
};
const reasons = site.text.why_rokka.reasons as { title: string; text: string }[];
---

<Base
  lang={lang}
  title={`${s.title} | rokka`}
  canonical={canonicalUrl('/signup', lang)}
  pageUrl="/signup"
  multilang
  pageTitle={s.title}
  pageDescription={s.text}
>
    <section class="section section--light" slot="content-wrapper">
          <div class="section__body">
            <div class="grid">
                <div class="grid__item md-w-2/3">
                    <div class="pipedriveWebForms" data-pd-webforms={PIPEDRIVE_FORM[lang]}><script src="https://pipedrivewebforms.com/webforms.min.js" is:inline></script></div>
                </div>
                <div class="grid__item md-w-1/3">
                    {reasons.map((reason, i) => (
                        <div class={`rokka-feature${i < reasons.length - 1 ? ' mrgb+' : ''}`}>
                            <h3 class="mrg0 h4 mrgb--"><div class="rokka-feature__icon"><Check /></div><Fragment set:html={reason.title} /></h3>
                            <p class="mrg0" set:html={reason.text} />
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </section>
</Base>
