---
/**
 * Port of source/contact/index.html (layout: default, multilang).
 *
 * The commented-out Pipedrive form block from the original is dropped: it was
 * inside an HTML comment, so Twig still evaluated it and shipped the markup to
 * every visitor as dead weight.
 */
import Base from '../../../layouts/Base.astro';
import { getSite, languagePaths, canonicalUrl, type Language } from '../../../data/site';

export function getStaticPaths() {
  return languagePaths();
}

const lang = Astro.params.lang as Language;
const site = getSite(lang);
const c = site.text.contact;
---

<Base
  lang={lang}
  title={`${c.title} | rokka`}
  canonical={canonicalUrl('/contact', lang)}
  pageUrl="/contact"
  multilang
  pageTitle={c.title}
  pageDescription={c.text}
>
    <section class="section section--light" slot="content-wrapper">
          <div class="section__body">
            <div class="grid">
                <div class="grid__item md-w-2/3">
                    <h2>{c.subtitle}</h2>
                    {c.body}<br/>
                    {c.body2}
                </div>

                <div class="grid__item md-w-1/3">
                    <div class="rokka-contact">
                        <div class="text-bold mrgb--">{c.mail}</div>
                        <a href="mailto:rokka@rokka.io" class="rokka-contact__mail">rokka@rokka.io</a>
                        <div class="text-bold mrgb--">{c.sales}</div>
                        <a href="mailto:sales@rokka.io" class="rokka-contact__mail">sales@rokka.io</a>
                        <div class="text-bold mrgt mrgb--">{c.phone}</div>
                        <div class="rokka-contact__phone">+41 43 500 39 80</div>
                        <div class="text-bold mrgt mrgb--">Twitter</div>
                        <a href="https://twitter.com/rokkaio" class="rokka-contact__mail">@rokkaio</a>
                        <div class="text-bold mrgt mrgb--">Slack</div>
                        <a href="https://join.slack.com/t/rokkaio/shared_invite/enQtMzI2ODM3MDgwNDM4LWNjY2MxMDBlNWNjZDViYjg3NjM1OWJjYjRmNjRjYTU5N2U3Yzg4NTM1OTdjMDUzNWE0Y2E4YzFmZWUzZmUwNTI" class="rokka-contact__mail">Get an invite.</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</Base>
