---
/**
 * Documentation search, powered by Pagefind (https://pagefind.app/).
 *
 * Same engine the LiipGPT manual uses -- there it comes for free with
 * Starlight, here it is wired up by hand because this site is plain Astro.
 *
 * How it works: `npm run build` emits dist/, then the `postbuild` script runs
 * the Pagefind binary over it. Pagefind crawls the built HTML, indexes every
 * region marked `data-pagefind-body` (only DocLayout and DemoLayout are, so the
 * marketing pages and the embedded dashboard stay out of the index) and writes
 * a static index plus its UI bundle to dist/pagefind/. Nothing runs server
 * side; the browser downloads only the index chunks a query actually needs.
 *
 * This uses Pagefind's Component UI -- the custom-element set it recommends for
 * new integrations since 1.5 -- rather than the older `new PagefindUI()`
 * widget: it is the one that gives a modal, a ctrl/cmd-K shortcut and the
 * WAI-ARIA combobox behaviour. `compact` renders the trigger as the bare
 * magnifying glass with no label, `hide-shortcut` drops the ⌘K badge next to it
 * (the shortcut itself keeps working -- the attribute only hides the hint).
 * `instance` pairs the trigger with its modal, so the two do not need to be
 * siblings; see the placement note in Base.astro.
 *
 * The two asset tags are `is:inline` on purpose: they are not bundled modules
 * but files Pagefind writes after Astro has finished, so Vite must not try to
 * resolve them. No init script is needed -- the elements upgrade themselves.
 *
 * Consequently the assets do not exist during `astro dev`; there is no dist/ to
 * index. Rendering the real widget there would log two 404s and leave an inert
 * element in the navbar, so dev gets a dimmed copy of Pagefind's own icon.
 * To try the real thing: `npm run build && npm run preview`.
 */
interface Props {
  /** Must be unique per page -- it pairs the trigger with its modal. */
  id?: string;
}

const { id = 'rokka-search' } = Astro.props;
---

{import.meta.env.PROD ? (
  <Fragment>
    <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" is:inline />
    <script src="/pagefind/pagefind-component-ui.js" type="module" is:inline></script>
    <pagefind-modal-trigger
      class="rokka-search"
      instance={id}
      compact
      hide-shortcut
      placeholder="Search the documentation"
    ></pagefind-modal-trigger>
    <pagefind-modal instance={id}></pagefind-modal>
  </Fragment>
) : (
  <span class="rokka-search rokka-search--unavailable" title="Search is only available in a production build">
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
      <path
        d="M12.7549 11.255H11.9649L11.6849 10.985C12.6649 9.845 13.2549 8.365 13.2549 6.755C13.2549 3.165 10.3449 0.255005 6.75488 0.255005C3.16488 0.255005 0.254883 3.165 0.254883 6.755C0.254883 10.345 3.16488 13.255 6.75488 13.255C8.36488 13.255 9.84488 12.665 10.9849 11.685L11.2549 11.965V12.755L16.2549 17.745L17.7449 16.255L12.7549 11.255ZM6.75488 11.255C4.26488 11.255 2.25488 9.245 2.25488 6.755C2.25488 4.26501 4.26488 2.255 6.75488 2.255C9.24488 2.255 11.2549 4.26501 11.2549 6.755C11.2549 9.245 9.24488 11.255 6.75488 11.255Z"
        fill="currentColor"
      />
    </svg>
  </span>
)}
