---
/**
 * Ported from source/_partials/footer.html.
 *
 * Static in both languages -- the old template had no Twig variables in here at
 * all, so the German site shipped this English footer too.
 *
 * The logo must be an inline <svg>, not an <img>: rokka.scss recolours it with
 * `.rokka-footer__logo-rokka g { fill: currentColor }`. gulp-inject-svg used to
 * do that swap at build time and carried the class over onto the <svg> root;
 * an Astro SVG component does the same thing at author time.
 */
import RokkaLogo from '../assets/images/rokka-logo.svg';
---

<section class="section section--white">
  <div class="section__body">
    <div class="rokka-footer flex pdgt">
      <div class="rokka-footer__logo flex-item-auto">
        <RokkaLogo class="rokka-footer__logo-rokka" />
      </div>
      <div class="rokka-footer__item flex-item-1 text-small md-text-right">
        <a href="http://www.liip.ch" class="d-block">
            Powered by Liip

        </a>
        <div>Limmatstrasse 183, CH-8005 Zürich, Switzerland</div>
        <div>+41 43 500 39 80</div>
        <div><a href="mailto:rokka@rokka.io" class="text-small">rokka@rokka.io</a></div>
        <div><a href="https://twitter.com/rokkaio" class="text-small">@rokkaio</a></div>

        <div>
          <a  class="text-small" href="https://www.liip.ch/en/blog/tags/rokka">
            Blog
          </a>
        </div>
        <div><a href="https://join.slack.com/t/rokkaio/shared_invite/enQtMzI2ODM3MDgwNDM4LWNjY2MxMDBlNWNjZDViYjg3NjM1OWJjYjRmNjRjYTU5N2U3Yzg4NTM1OTdjMDUzNWE0Y2E4YzFmZWUzZmUwNTI" class="text-small">rokkaio.slack.com</a></div>

        <div><a href="https://status.rokka.io/">status.rokka.io</a></div>
      </div>
    </div>
  </div>
</section>
