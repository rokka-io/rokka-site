                      <div class="text-small" set:html={t.pricing.paid.storage_text2} />
                    </div>
                  </div>
                </div>
              </div>

              <div class="number flex-item-1">
                <div class="flex pdgr-">
                  <div class="number__text">
                    <div class="number__value number__value--chf h2 mrg0 text-primary">0.50</div>
                    <div class="number__description">
                      <div class="text-small">&#160;</div>
                      <div class="text-bold" set:html={t.pricing.paid.traffic_text1} />
                      <div class="text-small" set:html={t.pricing.paid.traffic_text2} />
                    </div>
