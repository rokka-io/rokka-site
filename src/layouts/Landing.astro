                    <th set:html={t.pricing.details.chf_per_gb_monthly} />
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>0 - 400</td>
                    <td>CHF 0.40</td>
                  </tr>

                  <tr>
                    <td>401 - 800</td>
                    <td>CHF 0.30</td>
                  </tr>

                  <tr>
                    <td>801 - 1200</td>
                    <td>CHF 0.20</td>
                  </tr>

                  <tr>
                    <td>1201 - 1600</td>
                    <td>CHF 0.10</td>
                  </tr>

                  <tr>
                    <td>1600 - ∞</td>
                    <td>CHF 0.08</td>
                  </tr>


                </tbody>
              </table>
            </div>
            <div class="grid__item md-w-1/2">
              <h4 set:html={t.pricing.details.traffic} />
              <table>
                <thead>
                  <tr>
                    <th set:html={t.pricing.details.amount_monthly} />
                    <th set:html={t.pricing.details.chf_per_gb} />
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>0 - 2000</td>
                    <td>CHF 0.50</td>
                  </tr>

                  <tr>
                    <td>2001 - 4000</td>
                    <td>CHF 0.42</td>
                  </tr>

                  <tr>
                    <td>4001 - 6000</td>
                    <td>CHF 0.34</td>
                  </tr>

                  <tr>
                    <td>6001 - 8000</td>
                    <td>CHF 0.26</td>
                  </tr>

                  <tr>
                    <td>8001 - ∞</td>
                    <td><a href={`/${lang}/contact`} set:html={t.pricing.details.contact} /></td>
                  </tr>
                </tbody>
              </table>

            </div>

          </div>
          <Fragment set:html={t.pricing.details.owncdn} /> <a href={`/${lang}/contact`} set:html={t.pricing.details.contact} />
        </div>
      </div>


      <div class="rokka-pricing rokka-pricing__free">
        <div class="grid grid--middle">
          <div class="grid__item md-w-1/2">
            <p class="mrg0 text-bold" set:html={t.pricing.free.title} />
            <p class="mrg0 rokka-pricing-box__desc" set:html={t.pricing.free.text} />
          </div>
          <div class="grid__item md-w-1/2">
            <div class="flex">
              <div class="number flex-item-1">
                <div class="flex pdgr-">
                  <div class="number__text">
                    <div class="number__value h3 mrg0 text-muted" set:html={t.pricing.free.free} />
                    <div class="number__description text-small" set:html={t.pricing.free.free_space} />
                  </div>
                </div>
              </div>

              <div class="number flex-item-1">
                <div class="flex pdgr-">
                  <div class="number__text">
                    <div class="number__value h3 mrg0 text-muted" set:html={t.pricing.free.free} />
                    <div class="number__description text-small" set:html={t.pricing.free.free_traffic} />
                  </div>
                </div>
              </div>

            </div>
          </div>
        </div>
      </div>
      <script
        is:inline
        define:vars={{ chfMonth: t.pricing.calculator.chfmonth, contactLabel: t.pricing.details.contact }}
      >
        var trafficPrices = {
          2000:	0.5,
          4000:	0.42,
          6000:	0.34,
          8000:	0.26,

        }

        var storagePrices = {
          400:	0.4,
          800:	0.3,
          1200:	0.2,
          1600:	0.1,
          999999: 0.08
        }

        function getPrice(storageInput, tierPrices) {
          var price =  Object.keys(tierPrices).reduce((prev, tierLimit) => {
            tierLimit = parseInt(tierLimit)
            var price = tierPrices[tierLimit]

            if (storageInput > prev.tierLimitBefore) {
              prev.total += price * (Math.min(tierLimit, storageInput) - prev.tierLimitBefore)
            }
            prev.tierLimitBefore = tierLimit
            return prev

          }, {total: 0, tierLimitBefore: 0})
          return price.total
        }

        function calculatePrice() {


          var form = document.getElementById('form')

          var storageInput = parseInt(form.storage.value)
          var trafficInput = parseInt(form.traffic.value)
          var storagePrice =0
          var trafficPrice = 0

          if (storageInput > 2 || trafficInput > 10) {
             storagePrice = getPrice(storageInput, storagePrices)
             trafficPrice = getPrice(trafficInput, trafficPrices)

          }
          document.getElementById('storagePrice').innerText = storagePrice.toFixed(2).replace('.00', '.-') + ' ' + chfMonth
          if (trafficInput > 8000) {
            document.getElementById('trafficPrice').innerText = contactLabel

          } else{
            document.getElementById('trafficPrice').innerText = trafficPrice.toFixed(2).replace('.00', '.-') + ' ' + chfMonth
          }
          if (trafficInput > 8000) {
            document.getElementById('totalPrice').innerText = contactLabel
          } else {
            document.getElementById('totalPrice').innerText = (storagePrice + trafficPrice).toFixed(2).replace('.00', '.-') + ' ' + chfMonth + ' '
          }

        }

        // `define:vars` wraps this script in an IIFE, so the declaration above
        // is function-scoped. The form calls calculatePrice() from inline
        // onkeyup/onchange attributes, which only see globals.
        window.calculatePrice = calculatePrice
      </script>
        <div class="rokka-pricing rokka-pricing__free" id="calculateForm">
        <form id="form" onkeyup="calculatePrice()" onchange="calculatePrice()">

        <div class="grid">
          <div class="grid__item md-w-1/2">
            <h3 class="mrg0 mrgb--" set:html={t.pricing.calculator.title} />
            <p class="mrg0 rokka-pricing-box__desc" set:html={t.pricing.calculator.text} />

            <p class="mrg0 rokka-pricing-box__desc text-bold"><Fragment set:html={t.pricing.calculator.total} />: <span id="totalPrice">0.- <Fragment set:html={t.pricing.calculator.chfmonth} /></span> </p>
          </div>
          <div class="grid__item md-w-1/2">
            <div class="flex">
              <div class="number flex-item-1">
                <div class="flex pdgr-">
                  <div class="number__text">
                    <div class="number__value h3 mrg0 text-bold" set:html={t.pricing.details.storage} />
                    <div class="number__description " style="padding-top: 10px"> <input  autocomplete="off" type="text" name="storage" value="0" size="5"> <Fragment set:html={t.pricing.calculator.gbmonth} /></div>
                    <div class="number__description " style="padding-top: 10px"> <span id="storagePrice">0.-  <Fragment set:html={t.pricing.calculator.chfmonth} /></span></div>
                  </div>
                </div>
              </div>

              <div class="number flex-item-1">
                <div class="flex pdgr-">
                  <div class="number__text">

                    <div class="number__value h3 mrg0 text-bold" set:html={t.pricing.details.traffic} />
                    <div class="number__description " style="padding-top: 10px"> <input  autocomplete="off" type="text" name="traffic" value="0" size="5"> <Fragment set:html={t.pricing.calculator.gbmonth} /></div>
                    <div class="number__description " style="padding-top: 10px"> <span id="trafficPrice">0.- <Fragment set:html={t.pricing.calculator.chfmonth} /></span> </div>
                  </div>
                </div>
              </div>

            </div>
          </div>

        </div>
        </form>
      </div>
    </div>


    <p class="text-tiny text-right text-muted">
      <a href={t.pricing.tos.link} target="_blank" set:html={t.pricing.tos.text} />
      <Fragment set:html={t.pricing.disclaimer} />
    </p>

  </div>
</section>




