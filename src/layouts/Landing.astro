          </div>
          <div class="grid__item md-w-1/2">
            <div class="flex">
              <div class="number flex-item-1">
                <div class="flex pdgr-">
                  <div class="number__text">
                    <div class="number__value number__value--chf h2 mrg0 text-primary">0.40</div>
                    <div class="number__description">
                      <div class="text-small" set:html={t.pricing.paid.monthly} />
