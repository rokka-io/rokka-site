  <Fragment slot="scripts">
  <script async src="https://platform.twitter.com/widgets.js" charset="utf-8" is:inline></script>
  <script is:inline>
      window.addEventListener('DOMContentLoaded', function() {
        var navbar = document.querySelector('.navbar');
        new Toolkit.Navbar(navbar, { mode: 'section' });
      });
      window.addEventListener('DOMContentLoaded', function() {

        document.querySelector('.rokka-pricing__details-link').addEventListener('click', function(e) {
          e.preventDefault();
          document.querySelector('.rokka-pricing__details').classList.add('rokka-pricing__details--open');
        });

        var hero = document.querySelector('.rokka-hero');

        window.setTimeout(function() {
          hero.classList.toggle('rokka-hero--appear');
        }, 800);

        window.setTimeout(function() {
          hero.classList.toggle('rokka-hero--animate');
        }, 2000);
      });
  </script>
  </Fragment>
