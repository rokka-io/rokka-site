    <meta content="summary_large_image" name="twitter:card"/>
    <meta content="https://rokka.rokka.io/dynamic/ab9144.jpg" name="twitter:image"/>
    <meta content="https://rokka.rokka.io/dynamic/ab9144.jpg" property="og:image"/>
    <meta content={site.sharing_title} name="twitter:title"/>
    <meta content={t.lead.text} name="twitter:description"/>
    <meta content={site.sharing_title} name="og:title"/>
    <meta content={t.lead.text} name="og:description"/>
  </Fragment>

  <Fragment slot="content-wrapper">
<style is:inline>
  #calculateForm input, #calculateForm  select {
    width: inherit ! important;
    height: 30px !important;
  }

  #calculateForm select {
