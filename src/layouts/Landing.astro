---
/**
 * Port of source/_views/landingpage.html, rendered at both `/` (English) and
 * `/en/` `/de/`.
 *
 * Notes on the tricky bits:
 *  - The pricing calculator had Twig interpolated into JavaScript string
 *    literals. That becomes `define:vars` on an `is:inline` script: the form
 *    calls calculatePrice() from inline `onkeyup`/`onchange`, so the function
 *    has to stay global and the script must not be bundled.
 *  - The commented-out "why rokka" variant from the original is dropped. It sat
 *    inside an HTML comment, but Twig still rendered it, so the markup (and its
 *    three broken `<use xlink:href="#check">` references to a sprite that was
 *    never inlined) shipped to every visitor.
 *  - The pricing tiers are still duplicated between the tables and the
 *    calculator's JS objects, exactly as before. Deduplicating them would be a
 *    behaviour change; flagged instead.
 */
import Base from './Base.astro';
import RokkaBox from '../assets/images/rokka-box.svg';
import FilePictureUpload from '../assets/images/icons/file-picture-upload.svg';
import CropPicture from '../assets/images/icons/crop-picture.svg';
import Rocket from '../assets/images/icons/rocket.svg';
import Check from '../assets/images/icons/check.svg';
import { getSite, canonicalUrl, type Language } from '../data/site';

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const site = getSite(lang);
const t = site.text;
const reasons = t.why_rokka.reasons as { title: string; text: string }[];
---

<Base
  lang={lang}
  title={site.sharing_title}
  canonical={canonicalUrl('/', lang)}
  pageUrl="/"
  multilang
  showBreadcrumb={false}
>
