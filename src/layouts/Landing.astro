        <div class="rokka-quote rokka-quote--right">
          <div class="rokka-quote__bubble">
            <h3 class="mrg0 mrgb--" set:html={t.testimonial1.title} />
            <p class="mrg0" set:html={t.testimonial1.quote} />
          </div>
          <div class="rokka-quote__person">
            <div class="flex flex-align-center">
              <div class="flex-item-auto">
                <div class="rokka-quote__avatar"></div>
              </div>
              <div class="flex-item-1">
                <div class="h4 mrg0" set:html={t.testimonial1.name} />
